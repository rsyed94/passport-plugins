{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "sh ./scripts/passport-hook.sh session-start cursor",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "sh ./scripts/passport-hook.sh guard cursor",
        "timeout": 5
      }
    ],
    "afterShellExecution": [
      {
        "command": "sh ./scripts/passport-hook.sh audit cursor",
        "timeout": 5
      }
    ]
  }
}
